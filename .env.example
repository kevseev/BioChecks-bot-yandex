# OAuth токен бота (Bot API Яндекс Мессенджера)
YANDEX_BOT_TOKEN=

# Интервал опроса getUpdates (сек)
YANDEX_POLL_INTERVAL_SEC=2

# Файл с offset (в Docker по умолчанию /data/yandex_updates_offset.txt)
# YANDEX_OFFSET_FILE=/data/yandex_updates_offset.txt

# Luna Platform API (префикс /6 или ваш)
# Из контейнера до хоста (Linux Docker): host.docker.internal
LUNA_BASE_URL=http://host.docker.internal:5000/6

LUNA_HTTP_USER=
LUNA_HTTP_PASSWORD=
# LUNA_BEARER_TOKEN=

# Если раньше включали webhook у бота — отключите (webhook_url: null), иначе getUpdates может быть пустым.
