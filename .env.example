# OAuth токен бота (Bot API Яндекс Мессенджера)
YANDEX_BOT_TOKEN=

# Интервал опроса getUpdates (сек)
YANDEX_POLL_INTERVAL_SEC=2

# Файл с offset (в Docker по умолчанию /data/yandex_updates_offset.txt)
# YANDEX_OFFSET_FILE=/data/yandex_updates_offset.txt

# Доступ по паролю: без пробелов в начале строк имён переменных (иначе dotenv их не видит).
# В Docker: каталог ./access_auth пробрасывается в контейнер; перед первым запуском:
#   mkdir -p access_auth && cp access_auth/access_users.example.json access_auth/access_users.json
# BOT_ACCESS_STORE=/data/access_auth/access_users.json
# BOT_AUTH_ENABLED=true
# BOT_ADMIN_LOGINS=your.login
# Пароль bootstrap: логин из BOT_BOOTSTRAP_ADMIN_LOGIN или первый из BOT_ADMIN_LOGINS
# BOT_BOOTSTRAP_ADMIN_LOGIN=your.login
# BOT_BOOTSTRAP_ADMIN_PASSWORD=seven187
# Сложность хэша (по умолчанию 200000)
# BOT_PASSWORD_PBKDF2_ITERATIONS=200000

# Luna Platform API (префикс /6 или ваш)
# Из контейнера до хоста (Linux Docker): host.docker.internal
LUNA_BASE_URL=http://host.docker.internal:5000/6

LUNA_HTTP_USER=
LUNA_HTTP_PASSWORD=
# LUNA_BEARER_TOKEN=

# Если раньше включали webhook у бота — отключите (webhook_url: null), иначе getUpdates может быть пустым.

# Веб в Docker: порт на loopback хоста (по умолчанию 80 → в контейнер 8080)
# WEB_PUBLISH_PORT=80
# Цепочка: HTTPS :443 nginx → http://127.0.0.1:$WEB_PUBLISH_PORT → контейнер :8080
# Локально без Docker: python -m app.web_main (по умолчанию WEB_PORT=8080)
